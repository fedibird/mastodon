# This is a sample configuration file. You can generate your configuration
# with the `rake mastodon:setup` interactive setup wizard, but to customize
# your setup even further, you'll need to edit it manually. This sample does
# not demonstrate all available configuration options. Please look at
# https://docs.joinmastodon.org/admin/config/ for the full documentation.

# Federation
# ----------
# This identifies your server and cannot be changed safely later
# ----------
LOCAL_DOMAIN=example.com

# Redis
# -----
REDIS_HOST=localhost
REDIS_PORT=6379

# PostgreSQL
# ----------
DB_HOST=/var/run/postgresql
DB_USER=mastodon
DB_NAME=mastodon_production
DB_PASS=
DB_PORT=5432

# ElasticSearch (optional)
# ------------------------
ES_ENABLED=true
ES_HOST=localhost
ES_PORT=9200
# Authentication for ES (optional)
ES_USER=elastic
ES_PASS=password

# Status translation (optional)
# -----------------------------
# Translated status text, spoilers, poll options, and media descriptions are
# sent to the configured provider. When both are set, DeepL is used.
# DEEPL_PLAN is `free` (api-free.deepl.com) or any other value (api.deepl.com).
# LIBRE_TRANSLATE_API_KEY is optional. The endpoint may be a local URL.
# Translation requests keep the normal HTTP timeouts unless overridden here
# (read timeout 10 seconds, read deadline 30 seconds). A positive integer sets
# both the read timeout and the read deadline. Blank or invalid values are ignored.
# TRANSLATION_TIMEOUT=30
#
# By default, only distributable statuses are sent to translation providers.
#
# If your LibreTranslate endpoint is self-hosted or otherwise fully trusted,
# this may be enabled to translate non-public statuses that the requesting
# user is already authorized to view.
#
# This can send private, direct, limited, mutual, and personal status text,
# content warnings, poll options, and media descriptions to LibreTranslate.
#
# Translation results, including non-public content, are stored in the
# configured Rails cache for up to one day.
#
# This setting applies only when LibreTranslate is the selected provider.
# It never allows private content to be sent to DeepL. Only the exact value
# true is accepted.
#
# LIBRE_TRANSLATE_ALLOW_PRIVATE=true
# -----------------------------
DEEPL_API_KEY=
DEEPL_PLAN=free
LIBRE_TRANSLATE_ENDPOINT=
LIBRE_TRANSLATE_API_KEY=

# Secrets
# -------
# Make sure to use `rake secret` to generate secrets
# -------
SECRET_KEY_BASE=
OTP_SECRET=

# Web Push
# --------
# Generate with `rake mastodon:webpush:generate_vapid_key`
# --------
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# User-owned external credential vault (optional until a consumer exists)
# ----------------------------------------------------------------------
# Encryption at rest for credentials a user supplies for an external service.
# This is NOT end-to-end encryption. An administrator who can read both the
# database and these keys can decrypt every stored credential. Losing every
# key makes the stored credentials unrecoverable; users must enter them again.
#
# Do not reuse SECRET_KEY_BASE, OTP_SECRET, VAPID keys, or a provider API key.
# There is no fallback to those secrets. If the variables below are unset,
# Mastodon still boots. store, decrypt, replace, and rotate fail closed.
#
# Generate one 32-byte key (standard Base64, not a real key to copy):
#   ruby -rsecurerandom -rbase64 -e 'puts Base64.strict_encode64(SecureRandom.random_bytes(32))'
#
# USER_EXTERNAL_CREDENTIAL_KEYS=v1:<base64 of 32 random bytes>
# USER_EXTERNAL_CREDENTIAL_PRIMARY_KEY=v1
#
# Rotation:
# 1. Add the new key beside the old one, under a new id. Do not replace the
#    bytes of an existing id. Rotation needs the old id to keep its old bytes.
#      USER_EXTERNAL_CREDENTIAL_KEYS=v2:<new key>,v1:<old key>
# 2. Set USER_EXTERNAL_CREDENTIAL_PRIMARY_KEY=v2
# 3. Deploy. New credentials are encrypted with v2. Existing rows still decrypt with v1.
# 4. Preview, then rotate. Both authenticate every row, including rows already
#    named v2. A tampered row is a failure, not already_primary.
#      DRY_RUN=1 bundle exec rake user_external_credentials:rotate
#      bundle exec rake user_external_credentials:rotate
# 5. Confirm no row still uses the old id. This count does not decrypt.
#      bundle exec rake user_external_credentials:key_counts
# 6. In a later deploy, remove v1 from USER_EXTERNAL_CREDENTIAL_KEYS.
# ----------------------------------------------------------------------

# Sending mail
# ------------
SMTP_SERVER=smtp.mailgun.org
SMTP_PORT=587
SMTP_LOGIN=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=notificatons@example.com

# File storage (optional)
# -----------------------
S3_ENABLED=true
S3_BUCKET=files.example.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ALIAS_HOST=files.example.com

# Maximum custom emoji file sizes
# If undefined or smaller than MAX_EMOJI_SIZE, the value
# of MAX_EMOJI_SIZE will be used for MAX_REMOTE_EMOJI_SIZE
# Units are in bytes
MAX_EMOJI_SIZE=51200
MAX_REMOTE_EMOJI_SIZE=204800

# Legacy administrators and UserRole
# -----------------------------------
# The post-migration that introduces this note does not read an environment
# variable and does not rewrite role_id. Owner and Admin cannot be told apart
# from the leftover admin flag: the admin UI and tootctl leave that flag as it
# was. To review hosted deployments, run:
#   tootctl accounts legacy_admin_roles
# and, only when those Owner rows should become Admin, add --reassign-to-admin.
# That can remove Owner, including DevOps, from an account that was kept as
# Owner on purpose. Individual changes use the roles UI or:
#   tootctl accounts modify USERNAME --role Owner
#   tootctl accounts modify USERNAME --role Admin
