{
  "@context": {
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "label": "rdfs:label",
    "comment": "rdfs:comment"
  },
  "@graph": [
    {
      "@id": "https://fedibird.com/ns/group/v1#protocols",
      "@type": "rdf:Property",
      "label": "Fedibird Group protocols",
      "comment": "A set of protocol-profile IRIs self-declared by the publishing Group Actor. This metadata is not an authorization grant, membership or role declaration; each IRI describes a specific delivery and submission protocol."
    },
    {
      "@id": "https://fedibird.com/ns/group/v1#MentionFollowAnnounce",
      "@type": "rdfs:Class",
      "label": "Fedibird Group MentionFollowAnnounce profile, version 1",
      "comment": "This Group accepts local submissions that mention the Group from accounts with completed Follow membership, subject to public or unlisted visibility constraints, then redistributes the original status URI using an ordinary Announce. It does not imply FEP-1b12 Announce(Create), FEP-400e Add, FEP-5219 role/affiliation, or permission for any specific viewer to post."
    }
  ]
}
