- history = preview_card.history

.batch-table__row{ class: [preview_card.requires_review? && 'batch-table__row--attention', !preview_card.requires_review? && !preview_card.trendable? && 'batch-table__row--muted'] }
  %label.batch-table__row__select.batch-table__row__select--aligned.batch-checkbox
    = f.check_box :preview_card_ids, { multiple: true, include_hidden: false }, preview_card.id

  .batch-table__row__content.pending-account
    .trend-review-summary
      .trend-review-summary__title
        = trend_review_badge(preview_card)
        = link_to preview_card.title, preview_card.url, class: 'trend-review-summary__preview'

      .trend-review-meta
        = trend_candidate_stats(rank: preview_card.trend.rank, score: preview_card.trend.score)
        %span= preview_card.domain
        - if preview_card.provider_name.present?
          %span= preview_card.provider_name
        - if preview_card.provider.present?
          %span= preview_card.provider.domain
        - if preview_card.language.present?
          %span= standard_locale_name(preview_card.language)
        %span= t('admin.trends.links.shared_by_over_week', count: history.reduce(0) { |sum, day| sum + day.accounts })
        %span= t('admin.trends.links.usage_comparison', today: history.get(Time.now.utc).uses, yesterday: history.get(1.day.ago).uses)
        - if preview_card.decaying?
          %span= t('admin.trends.tags.peaked_on_and_decaying', date: l(preview_card.max_score_at.to_date, format: :short))
