.batch-table__row{ class: [tag.requires_review? && 'batch-table__row--attention', !tag.requires_review? && !tag.trendable? && 'batch-table__row--muted'] }
  %label.batch-table__row__select.batch-table__row__select--aligned.batch-checkbox
    = f.check_box :tag_ids, { multiple: true, include_hidden: false }, tag.id

  .batch-table__row__content.pending-account
    .trend-review-summary
      .trend-review-summary__title
        = trend_review_badge(tag)
        = link_to admin_tag_path(tag.id) do
          = fa_icon 'hashtag'
          = tag.display_name

      - history = tag.history
      .trend-review-meta
        %span
          = link_to tag_path(tag), target: '_blank' do
            = t('admin.trends.tags.used_by_over_week', count: history.sum { |day| day[:accounts].to_i })
        %span= t('admin.trends.tags.usage_comparison', today: history[0][:uses], yesterday: history[1][:uses])
        = trend_candidate_stats(rank: (rank = Trends.tags.rank(tag.id)) && rank + 1, score: Trends.tags.recorded_score(tag.id))
        - if tag.decaying?
          %span= t('admin.trends.tags.peaked_on_and_decaying', date: l(tag.max_score_at.to_date, format: :short))
