- review = invite_creation_review(invite)
- held = InviteCreation::ReviewLookup.held_review?(review)
%tr
  %td
    - if held
      = t(review.pending_state? ? 'invites.review.waiting' : 'invites.review.stopped')
      - if review.pending_state?
        = link_to t('admin.invites.review_link'), admin_action_review_path(review)
    - else
      .input-copy
        .input-copy__wrapper
          %input{ type: :text, maxlength: '999', spellcheck: 'false', readonly: 'true', value: public_invite_url(invite_code: invite.code) }
        %button{ type: :button }= t('generic.copy')
      - if review&.approved_state?
        %span= t('admin.invites.review_approved')

  %td
    .name-tag
      = image_tag invite.user.account.avatar.url(:original), alt: '', width: 16, height: 16, class: 'avatar'
      %span.username= invite.user.account.username

  %td{ class: invite.valid_for_use? ? nil : 'expired' }
    = fa_icon 'user fw'
    = invite.uses
    = " / #{invite.max_uses}" unless invite.max_uses.nil?
  %td
    - if held
      = t(review.pending_state? ? 'admin.invites.review_waiting' : 'admin.invites.review_stopped')
    - elsif !invite.valid_for_use?
      = t('invites.expired')
    - elsif invite.expires_at.nil?
      ∞
    - else
      %time.formatted{ datetime: invite.expires_at.iso8601, title: l(invite.expires_at) }
        = l invite.expires_at

  %td
    - if !held && invite.valid_for_use? && policy(invite).destroy?
      = table_link_to 'times', t('invites.delete'), admin_invite_path(invite), method: :delete
