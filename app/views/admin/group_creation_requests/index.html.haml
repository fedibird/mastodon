- content_for :page_title do
  = t('admin.group_creation_requests.title')

- content_for :heading_actions do
  = link_to t('admin.managed_groups.title'), admin_managed_groups_path, class: 'button'
  = link_to t('admin.group_registration_invite_defaults.title'), edit_admin_group_registration_invite_defaults_path, class: 'button'

%p.muted-hint= t('admin.group_creation_requests.lead')
- unless @feature_enabled
  .flash-message.alert
    = t('admin.group_creation_requests.feature_disabled_banner')

.filters
  .filter-subset
    %strong= t('admin.group_creation_requests.state')
    %ul
      %li= filter_link_to t('admin.group_creation_requests.states.pending'), state: nil
      %li= filter_link_to t('admin.group_creation_requests.states.approved'), state: 'approved'
      %li= filter_link_to t('admin.group_creation_requests.states.rejected'), state: 'rejected'
      %li= filter_link_to t('admin.group_creation_requests.states.cancelled'), state: 'cancelled'
      %li= filter_link_to t('admin.group_creation_requests.states.all'), state: 'all'

- if @requests.empty?
  %p.muted-hint.center-text= t('admin.group_creation_requests.empty')
- else
  .table-wrapper
    %table.table
      %thead
        %tr
          %th= t('admin.group_creation_requests.username')
          %th= t('admin.group_creation_requests.requester')
          %th= t('admin.group_creation_requests.requested_at')
          %th= t('admin.group_creation_requests.state')
      %tbody
        - @requests.each do |group_request|
          %tr
            %td= link_to group_request.username, admin_group_creation_request_path(group_request)
            %td= admin_account_inline_link_to(group_request.requester_account)
            %td= formatted_browser_local_time(group_request.requested_at)
            %td= group_creation_state_label(group_request.state)

= paginate @requests
