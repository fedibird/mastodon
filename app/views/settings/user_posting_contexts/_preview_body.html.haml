%dl.user-posting-context-preview__list
  %dt= t('user_posting_contexts.preview_labels.destination')
  %dd{ dir: 'auto' }= user_posting_context_target_label(@context)
  %dt= t('user_posting_contexts.preview_labels.discovery')
  %dd= user_posting_context_discovery_explanation(@preview)
  %dt= t('user_posting_contexts.preview_labels.visibility')
  %dd
    = user_posting_context_visibility_label(@preview.visibility.value)
    %span.user-posting-context-preview__source= user_posting_context_source_label(@preview.visibility.source)
    - if @preview.visibility.inherited?
      %span.user-posting-context-preview__usual= t('user_posting_contexts.preview_labels.usual', value: user_posting_context_visibility_label(@preview.visibility.usual_value))
  %dt= t('user_posting_contexts.preview_labels.language')
  %dd
    = user_posting_context_language_label(@preview.language.value)
    %span.user-posting-context-preview__source= user_posting_context_source_label(@preview.language.source)
    - if @preview.language.inherited?
      %span.user-posting-context-preview__usual= t('user_posting_contexts.preview_labels.usual', value: user_posting_context_language_label(@preview.language.usual_value))
  %dt= t('user_posting_contexts.preview_labels.spoiler')
  %dd
    %span{ dir: 'auto' }= user_posting_context_spoiler_label(@preview.spoiler.value)
    %span.user-posting-context-preview__source= user_posting_context_source_label(@preview.spoiler.source)
  %dt= t('user_posting_contexts.preview_labels.sensitive')
  %dd
    = user_posting_context_sensitive_label(@preview.sensitive.value == true)
    %span.user-posting-context-preview__source= user_posting_context_source_label(@preview.sensitive.source)
  %dt= t('user_posting_contexts.preview_labels.user_hashtags')
  %dd
    - if @preview.user_hashtags.empty?
      = t('user_posting_contexts.no_hashtags')
    - else
      %ul
        - @preview.user_hashtags.each do |tag|
          %li{ dir: 'auto' }
            = "##{tag['name']}"
            %span.user-posting-context-preview__source= t('user_posting_contexts.advisory')
  %dt= t('user_posting_contexts.preview_labels.required')
  %dd
    - if @preview.discovery_trust == 'unverified'
      = t('user_posting_contexts.unverified_banner')
    - elsif @preview.required_rules.empty?
      = t('user_posting_contexts.required_empty')
    - else
      %ul
        - @preview.required_rules.each do |rule|
          %li{ dir: 'auto' }= t("user_posting_contexts.rules.#{rule['kind']}", label: rule['label'])
  %dt= t('user_posting_contexts.preview_labels.recommended')
  %dd
    - if @preview.discovery_trust == 'unverified'
      = t('user_posting_contexts.unverified_banner')
    - elsif @preview.recommended_rules.empty?
      = t('user_posting_contexts.recommended_empty')
    - else
      %ul
        - @preview.recommended_rules.each do |rule|
          %li{ dir: 'auto' }= rule['label']
  %dt= t('user_posting_contexts.preview_labels.conflicts')
  %dd
    - if @preview.conflicts.empty?
      = t('user_posting_contexts.conflicts_empty')
    - else
      %ul
        - @preview.conflicts.each do |conflict|
          %li= user_posting_context_conflict_text(conflict)
