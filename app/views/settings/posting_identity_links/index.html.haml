- content_for :page_title do
  = t('posting_identity_links.title')

.posting-identity-links
  %p= t('posting_identity_links.description')

  %section.posting-identity-links__section
    %h3= t('posting_identity_links.current_account')
    %p
      %strong= current_account.pretty_acct

  - if flash[:posting_identity_token].present?
    %section.posting-identity-links__section.posting-identity-links__code{ role: 'status' }
      %h3= t('posting_identity_links.code_once')
      %p.posting-identity-links__token= flash[:posting_identity_token]
      %p= t('posting_identity_links.code_hint')

  - if current_user.can?(:administrator)
    %section.posting-identity-links__section
      %h3= t('posting_identity_links.request_title')
      = form_with url: settings_posting_identity_links_path, method: :post, local: true do
        .fields-group
          = label_tag :acct, t('posting_identity_links.acct_label')
          = text_field_tag :acct, params[:acct], required: true, autocomplete: 'off', autocapitalize: 'off', spellcheck: false
        .fields-group
          = hidden_field_tag 'scopes[]', 'post'
          = label_tag 'scopes_media' do
            = check_box_tag 'scopes[]', 'media', Array(params[:scopes]).include?('media'), id: 'scopes_media'
            = t('posting_identity_links.scopes.media')
          %p.hint= t('posting_identity_links.scopes.post_included')
        = submit_tag t('posting_identity_links.request_submit')

  %section.posting-identity-links__section
    %h3= t('posting_identity_links.pending_title')
    - pending = @pending.select(&:open?)
    - if pending.empty?
      %p= t('posting_identity_links.pending_empty')
    - else
      %ul.posting-identity-links__list
        - pending.each do |link_request|
          %li
            %p= t('posting_identity_links.pending_item', acct: link_request.target_user.account.pretty_acct, scopes: posting_identity_scope_labels(link_request.scopes), expires_at: l(link_request.expires_at))
            = button_to t('posting_identity_links.cancel'), cancel_settings_posting_identity_link_path(link_request), method: :post

  %section.posting-identity-links__section
    %h3= t('posting_identity_links.linked_title')
    - active_received = @received.select(&:active_record?)
    - if active_received.empty?
      %p= t('posting_identity_links.linked_empty')
    - else
      %ul.posting-identity-links__list
        - active_received.each do |delegation|
          %li
            %p= t('posting_identity_links.linked_item', acct: delegation.posting_account.pretty_acct, scopes: posting_identity_scope_labels(delegation.scopes), expires_at: l(delegation.expires_at))
            %p.hint= t('posting_identity_links.sending_not_enabled')
            = button_to t('posting_identity_links.unlink'), unlink_settings_posting_identity_grant_path(delegation), method: :post

  %section.posting-identity-links__section
    %h3= t('posting_identity_links.expired_title')
    - closed = @received.reject(&:active_record?)
    - if closed.empty?
      %p= t('posting_identity_links.expired_empty')
    - else
      %ul.posting-identity-links__list
        - closed.each do |delegation|
          %li
            %p= t('posting_identity_links.expired_item', acct: delegation.posting_account.pretty_acct, scopes: posting_identity_scope_labels(delegation.scopes), expires_at: l(delegation.expires_at))

  %section.posting-identity-links__section
    %h3= t('posting_identity_links.granted_title')
    %p= link_to t('posting_identity_links.approve_link'), new_settings_posting_identity_approval_path
    - active_granted = @granted.select(&:active_record?)
    - if active_granted.empty?
      %p= t('posting_identity_links.granted_empty')
    - else
      %ul.posting-identity-links__list
        - active_granted.each do |delegation|
          %li
            %p= t('posting_identity_links.granted_item', acct: delegation.grantee_user.account.pretty_acct, scopes: posting_identity_scope_labels(delegation.scopes), expires_at: l(delegation.expires_at), approved_at: l(delegation.approved_at))
            = button_to t('posting_identity_links.revoke'), revoke_settings_posting_identity_grant_path(delegation), method: :post
