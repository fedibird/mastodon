- content_for :page_title do
  = t('settings.import')

= simple_form_for @import, url: settings_import_path do |f|
  .field-group
    = f.input :type, collection: Import.types.keys, wrapper: :with_block_label, include_blank: false, label_method: lambda { |type| I18n.t("imports.types.#{type}") }, hint: t('imports.preface')

  .fields-row
    .fields-group.fields-row__column.fields-row__column-6
      = f.input :data, wrapper: :with_block_label, hint: t('simple_form.hints.imports.data')
    .fields-group.fields-row__column.fields-row__column-6
      = f.input :mode, as: :radio_buttons, collection: Import::MODES, label_method: lambda { |mode| safe_join([I18n.t("imports.modes.#{mode}"), content_tag(:span, I18n.t("imports.modes.#{mode}_long"), class: 'hint')]) }, collection_wrapper_tag: 'ul', item_wrapper_tag: 'li'

  .actions
    = f.button :button, t('imports.upload'), type: :submit

- if @follow_import_batches.present?
  %hr.spacer/

  %h4= t('imports.follow_progress.title')
  %p.hint= t('imports.follow_progress.hint')

  .table-wrapper
    %table.table
      %thead
        %tr
          %th= t('imports.follow_progress.imported_at')
          %th= t('imports.follow_progress.status_column')
          %th= t('imports.follow_progress.processed')
          %th= t('imports.follow_progress.waiting')
          %th= t('imports.follow_progress.failed')
      %tbody
        - @follow_import_batches.each do |batch|
          - summary = follow_import_progress(batch)
          %tr
            %td= l(batch.imported_at)
            %td= follow_import_status_label(summary)
            %td= t('imports.follow_progress.processed_of', count: summary['processed'], total: summary['total'])
            %td= number_with_delimiter(summary['waiting'])
            %td= number_with_delimiter(summary['failed'])
