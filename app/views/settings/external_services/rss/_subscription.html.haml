%article.external-service-feed{ aria: { labelledby: "rss-feed-title-#{subscription.id}" }, data: { deleting_subscription_id: (subscription.id if subscription.deleting?) } }
  .external-service-feed__heading
    %span.external-service-feed__icon{ aria: { hidden: 'true' } }
      = image_pack_tag ExternalServices::RSS.icon, alt: '', class: 'external-service-feed__icon-default'
      - if subscription.icon_url
        %img.external-service-feed__icon-image{ src: subscription.icon_url, alt: '', loading: 'lazy', decoding: 'async', referrerpolicy: 'no-referrer' }
    %h5.external-service-feed__title{ id: "rss-feed-title-#{subscription.id}" }= subscription.title
    %p.external-service-card__status
      %span{ class: "external-service-card__badge external-service-card__badge--#{subscription.badge}" }= subscription.state_label
  %p.external-service-feed__url
    %span.external-service-kicker= t('external_bridge.feed_url')
    - if subscription.linkable_url
      = link_to subscription.url, subscription.linkable_url, rel: 'nofollow noopener noreferrer'
    - else
      = subscription.url
  %p.external-service-feed__meta
    %span.external-service-kicker= t('external_bridge.last_checked')
    - if subscription.checked_at
      %time{ datetime: subscription.checked_at.iso8601 }= l(subscription.checked_at)
    - else
      = t('external_services.not_checked')
  - if subscription.fetch_error_message
    %p.warning-hint= subscription.fetch_error_message
  - if subscription.partial_failure_message
    %p.hint= subscription.partial_failure_message
  - if subscription.retry_message
    %p.hint= subscription.retry_message
  - if subscription.deleting?
    %p.hint= t('external_bridge.deletion.subscription_note')
  - else
    = render 'settings/external_services/feed_routes/picker', subscription_id: subscription.id, title: subscription.title, route_form: subscription.route_form, form_url: settings_external_services_rss_subscription_feed_routes_path(subscription.id), page_number: @page&.page
  - unless subscription.deleting?
    = form_with url: settings_external_services_rss_subscription_presentation_path(subscription.id), method: :patch, local: true, html: { class: 'external-service-presentation' } do
      %fieldset
        %legend= t('external_bridge.presentation.heading')
        .external-service-presentation__language
          .external-service-help-row
            %label{ for: "rss-language-#{subscription.id}" }= t('external_bridge.presentation.language')
            = render 'settings/external_services/help', body_id: "rss-language-hint-#{subscription.id}", label: t('external_bridge.presentation.language_help'), text: t('external_bridge.presentation.language_hint'), controls: "rss-language-#{subscription.id}"
          = select_tag :language, options_for_select(rss_presentation_language_options(subscription.language_choice), subscription.language_choice), id: "rss-language-#{subscription.id}"
        .external-service-presentation__choice
          = hidden_field_tag :media_sensitive, '0', id: nil
          .external-service-help-row
            %label{ for: "rss-media-sensitive-#{subscription.id}" }
              = check_box_tag :media_sensitive, '1', subscription.media_sensitive?, id: "rss-media-sensitive-#{subscription.id}"
              %span= t('external_bridge.presentation.media_sensitive')
            = render 'settings/external_services/help', body_id: "rss-media-sensitive-hint-#{subscription.id}", label: t('external_bridge.presentation.media_sensitive_help'), text: t('external_bridge.presentation.media_sensitive_hint'), controls: "rss-media-sensitive-#{subscription.id}"
        .external-service-presentation__choice
          = hidden_field_tag :cw_enabled, '0', id: nil
          .external-service-help-row
            %label{ for: "rss-cw-enabled-#{subscription.id}" }
              = check_box_tag :cw_enabled, '1', subscription.cw_enabled?, id: "rss-cw-enabled-#{subscription.id}"
              %span= t('external_bridge.presentation.cw_enabled')
            = render 'settings/external_services/help', body_id: "rss-cw-hint-#{subscription.id}", label: t('external_bridge.presentation.cw_help'), text: t('external_bridge.presentation.cw_enabled_hint'), controls: "rss-cw-enabled-#{subscription.id}"
        = hidden_field_tag :page, @page.page, id: nil if @page&.page.to_i > 1
        .actions
          = button_tag t('external_bridge.presentation.save'), type: 'submit', class: 'button', data: { disable_with: t('external_bridge.working') }, aria: { label: t('external_bridge.presentation.save_for', title: subscription.title) }
      - if subscription.presentation_message
        %p.hint.external-service-presentation__progress{ role: 'status', aria: { live: 'polite' } }= subscription.presentation_message
    .external-service-actions
      - if subscription.pausable?
        = button_to t('external_bridge.pause'), settings_pause_external_services_rss_subscription_path(subscription.id), method: :post, class: 'button', form_class: 'external-service-inline-form', aria: { label: t('external_bridge.pause_for', title: subscription.title) }, data: { disable_with: t('external_bridge.working') }
      - elsif permitted
        = button_to t('external_bridge.resume'), settings_resume_external_services_rss_subscription_path(subscription.id), method: :post, class: 'button', form_class: 'external-service-inline-form', aria: { label: t('external_bridge.resume_for', title: subscription.title) }, data: { disable_with: t('external_bridge.working') }
      - else
        %button.button{ type: 'button', disabled: true, aria: { describedby: 'rss-blocked-reason' } }= t('external_bridge.resume')
      = button_to t('external_bridge.unsubscribe'), settings_external_services_rss_subscription_path(subscription.id), method: :delete, class: 'button negative', form_class: 'external-service-inline-form', aria: { label: t('external_bridge.unsubscribe_for', title: subscription.title), describedby: 'rss-unsubscribe-note' }, data: { confirm: t('external_bridge.unsubscribe_confirm'), disable_with: t('external_bridge.working') }
