- content_for :page_title do
  = t('external_services.providers.rss.name')

.external-services
  %p
    = link_to settings_external_services_path, class: 'external-services__back' do
      = t('external_services.back')

  .external-service-header
    = render 'settings/external_services/icon', icon: ExternalServices::RSS.icon
    .external-service-header__text
      .external-service-help-row
        %h3= t('external_services.providers.rss.name')
        = render 'settings/external_services/help', body_id: 'rss-privacy-note', label: t('external_bridge.privacy_help'), text: t('external_bridge.privacy_note'), controls: 'rss-subscribe'
      %p= t('external_services.providers.rss.description')

  - if @page.blocked_reason
    %p.warning-hint#rss-blocked-reason{ role: 'status' }= @page.blocked_reason

  - if @page.show_form?
    = form_with url: settings_external_services_rss_subscriptions_path, method: :post, local: true, html: { class: 'external-service-form' } do
      .fields-group
        = label_tag 'rss-feed-url', t('external_bridge.feed_url')
        = url_field_tag :feed_url, nil, id: 'rss-feed-url', required: true, placeholder: 'https://example.com/feed.xml', autocomplete: 'off', spellcheck: 'false', autocapitalize: 'none', aria: { describedby: 'rss-feed-url-hint' }
      %p.hint#rss-feed-url-hint= t('external_bridge.feed_url_hint')
      .actions
        = button_tag t('external_bridge.subscribe'), type: 'submit', id: 'rss-subscribe', class: 'button', data: { disable_with: t('external_bridge.working') }, aria: { describedby: 'rss-feed-url-hint' }

  - if @page.deletions.any?
    %section.external-service-deletions{ aria: { labelledby: 'rss-deletions-title' } }
      %h4#rss-deletions-title= t('external_bridge.deletion.heading')
      %p.hint= t('external_bridge.deletion.note')
      - @page.deletions.each do |deletion|
        = render 'settings/external_services/rss/deletion', deletion: deletion, permitted: @page.permitted

  %h4= t('external_bridge.subscriptions')
  %p.hint= t('external_bridge.cadence_note')
  %p.hint#rss-unsubscribe-note= t('external_bridge.unsubscribe_note')
  - if @page.subscriptions.empty?
    %p.hint= @page.show_form? ? t('external_bridge.no_subscriptions') : t('external_bridge.no_subscriptions_blocked')
  - else
    .external-service-feeds
      - @page.subscriptions.each do |subscription|
        = render 'settings/external_services/rss/subscription', subscription: subscription, permitted: @page.permitted
    - if @page.total_pages > 1
      %nav.external-service-pager{ aria: { label: t('external_bridge.page_nav') } }
        - if @page.page > 1
          = link_to t('external_bridge.previous'), settings_external_services_rss_path(page: @page.page - 1), rel: 'prev'
        - if @page.page < @page.total_pages
          = link_to t('external_bridge.next'), settings_external_services_rss_path(page: @page.page + 1), rel: 'next'

  %details.external-service-disclosure
    %summary= t('external_bridge.items')
    %p.hint= t('external_bridge.items_note')
    - if @page.items.empty?
      %p.hint= t('external_bridge.no_items')
    - else
      %ul.external-service-items
        - @page.items.each do |item|
          %li
            = link_to item.external_resource&.title.presence || t('external_bridge.untitled'), short_account_status_path(current_account.username, item.status_id)
            - if item.source_deleted
              %span.external-service-kicker= t('external_bridge.source_deleted')
