- content_for :page_title do
  = t('external_services.title')

.external-services
  .external-service-header
    %h3= t('external_services.title')
    = link_to new_settings_external_service_path, class: 'button external-services__add' do
      = t('external_services.add_service')

  - if @connections.empty?
    %p.hint= t('external_services.empty')
  - else
    .external-services__grid
      - @connections.each do |connection|
        = render 'connection_card', connection: connection
