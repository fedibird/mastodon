- content_for :page_title do
  = t('external_services.providers.bluesky.name')

.external-services
  %p
    = link_to settings_external_services_path, class: 'external-services__back' do
      = t('external_services.back')

  .external-service-header
    = render 'settings/external_services/icon', icon: ExternalServices::Bluesky.icon
    .external-service-header__text
      %h3= t('external_services.providers.bluesky.name')
      %p= t('external_services.providers.bluesky.description')

  %p.hint#bluesky-scope-note= t('external_bridge.atproto.scope_note')
  %p.hint#bluesky-live-gate-note= t('external_bridge.atproto.live_gate_note')

  - if @page.blocked_reason
    %p.warning-hint#bluesky-blocked-reason{ role: 'status' }= @page.blocked_reason

  - if @page.connectable?
    = form_with url: settings_external_services_bluesky_authorize_path, method: :post, local: true, html: { class: 'external-service-form' } do
      .fields-group
        = label_tag 'bluesky-handle', t('external_bridge.atproto.account_label')
        = text_field_tag :account, nil, id: 'bluesky-handle', required: true, autocomplete: 'off', spellcheck: 'false', autocapitalize: 'none', placeholder: 'alice.bsky.social', aria: { describedby: 'bluesky-handle-hint' }
      %p.hint#bluesky-handle-hint= t('external_bridge.atproto.account_hint')
      %details.external-service-disclosure
        %summary= t('external_bridge.atproto.advanced')
        %p.hint= t('external_bridge.atproto.advanced_hint')
      %p.hint#bluesky-return-note= t('external_bridge.atproto.return_note')
      .actions
        = button_tag t('external_bridge.atproto.connect'), type: 'submit', class: 'button', data: { disable_with: t('external_bridge.working') }, aria: { describedby: 'bluesky-scope-note bluesky-return-note bluesky-live-gate-note' }

  %h4= t('external_bridge.atproto.connections')
  %p.hint#bluesky-disconnect-note= t('external_bridge.atproto.disconnect_note')
  - if @page.identities.empty?
    %p.hint= t('external_bridge.atproto.none')
  - else
    .external-service-identities
      - @page.identities.each do |identity|
        = render 'identity', identity: identity, connectable: @page.connectable?
    - if @page.total_pages > 1
      %nav.external-service-pager{ aria: { label: t('external_bridge.page_nav') } }
        - if @page.page > 1
          = link_to t('external_bridge.previous'), settings_external_services_bluesky_path(page: @page.page - 1), rel: 'prev'
        - if @page.page < @page.total_pages
          = link_to t('external_bridge.next'), settings_external_services_bluesky_path(page: @page.page + 1), rel: 'next'
