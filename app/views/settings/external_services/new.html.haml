- content_for :page_title do
  = t('external_services.catalog_title')

.external-services
  .external-service-header
    %h3= t('external_services.catalog_title')
    = link_to settings_external_services_path, class: 'external-services__back' do
      = t('external_services.back')

  .external-services__grid
    - @providers.each do |provider|
      = render 'catalog_card', provider: provider
