- filter_active = CustomFilter.still_active?(filter)
.filters-list__item{ class: [filter.expires? && !filter_active && 'expired'] }
  = link_to edit_filter_path(filter, embedded_filter_options), class: 'filters-list__item__title' do
    %span{ data: { custom_emoji_text: true } }= filter.title

    - if filter.expires?
      .expiration{ title: t('filters.index.expires_on', date: l(filter.expires_at)) }
        - if filter_active
          = t('filters.index.expires_in_at', distance: distance_of_time_in_words_to_now(filter.expires_at), date: l(filter.expires_at))
        - else
          = t('filters.index.expired_at', date: l(filter.expires_at))
    - elsif filter.filter_tags.any?
      .expiration
        = t('filters.index.indefinite')

  .filters-list__item__permissions
    %ul.permissions-list
      - unless filter.filter_tags.empty?
        %li.permissions-list__item
          .permissions-list__item__icon
            = fa_icon('hashtag')
          .permissions-list__item__text
            .permissions-list__item__text__title
              = t('filters.index.hashtags', count: filter.filter_tags.size)
            .permissions-list__item__text__type
              = filter.filter_tags.map { |tag_rule| "##{tag_rule.name}" }.join(', ')
      - unless filter.keywords.empty?
        %li.permissions-list__item
          .permissions-list__item__icon
            = fa_icon('paragraph')
          .permissions-list__item__text
            .permissions-list__item__text__title
              = t('filters.index.keywords', count: filter.keywords.size)
            .permissions-list__item__text__type
              - keywords = filter.keywords.map(&:keyword)
              - keywords = keywords.take(5) + ['…'] if keywords.size > 5 # TODO
              = keywords.join(', ')
      - unless filter.statuses.empty?
        %li.permissions-list__item
          .permissions-list__item__icon
            = fa_icon('commenting-o')
          .permissions-list__item__text
            .permissions-list__item__text__title
              = t('filters.index.statuses', count: filter.statuses.size)
            .permissions-list__item__text__type
              = t('filters.index.statuses_long', count: filter.statuses.size)

  .announcements-list__item__action-bar
    .announcements-list__item__meta
      = t('filters.index.contexts', contexts: filter.context.map { |context| I18n.t("filters.contexts.#{context}") }.join(', '))

    %div
      = table_link_to 'edit', t('filters.edit.title'), edit_filter_path(filter, embedded_filter_options)
      = table_link_to 'close', t('filters.index.delete'), filter_path(filter, embedded_filter_options), method: :delete, data: { confirm: t('admin.accounts.are_you_sure') }
