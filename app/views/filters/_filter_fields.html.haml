.fields-row
  .fields-row__column.fields-row__column-6.fields-group
    = f.input :title,
              as: :string,
              hint: false,
              wrapper: :with_label,
              input_html: { data: { emoji_picker: true } }
  .fields-row__column.fields-row__column-6.fields-group
    = f.input :expires_in,
              collection: CustomFilter::EXPIRATION_DURATIONS.map(&:to_i),
              include_blank: I18n.t('invites.expires_in_prompt'),
              label_method: ->(i) { I18n.t("invites.expires_in.#{i}") },
              wrapper: :with_label

.fields-group
  %fieldset.filter-contexts
    %legend.filter-contexts__legend
      = t('filters.edit.contexts')
      %abbr{ title: t('simple_form.required.text') }= t('simple_form.required.mark')
    %p.filter-contexts__hint= t('filters.edit.contexts_hint')
    - if f.object.errors[:context].present?
      %p.filter-contexts__error= f.object.errors[:context].to_sentence
    .filter-contexts__toolbar
      %button.filter-contexts__bulk{ type: 'button', data: { filter_contexts_action: 'select-all' } }= t('filters.edit.select_all')
      %button.filter-contexts__bulk{ type: 'button', data: { filter_contexts_action: 'select-none' } }= t('filters.edit.select_none')
    - description_ids = CustomFilter::VALID_CONTEXTS.map { |context| "custom_filter_context_#{context}_description" }
    %details.filter-contexts__disclosure
      %summary.filter-contexts__summary{ aria: { controls: description_ids.join(' ') }, data: { show_label: t('filters.edit.show_context_descriptions'), hide_label: t('filters.edit.hide_context_descriptions') } }
        = t('filters.edit.show_context_descriptions')
      %p.filter-contexts__disclosure-note= t('filters.edit.context_descriptions_shown')
    #filter-context-choices.filter-contexts__list
      = f.collection_check_boxes :context, CustomFilter::VALID_CONTEXTS, :itself, :itself do |builder|
        - context = builder.value
        - input_id = "custom_filter_context_#{context}"
        - description_id = "#{input_id}_description"
        .filter-contexts__item
          = builder.label(for: input_id, class: 'filter-contexts__choice') do
            = builder.check_box(id: input_id)
            %span.filter-contexts__name= t("filters.contexts.#{context}")
          %p.filter-contexts__description{ id: description_id }= t("filters.context_descriptions.#{context}")

%hr.spacer/

.fields-group
  = f.input :filter_action,
            as: :radio_buttons,
            collection: %i(warn hide),
            hint: t('simple_form.hints.filters.action'),
            label: t('simple_form.labels.filters.action'),
            include_blank: false,
            label_method: ->(action) { filter_action_label(action) },
            required: true,
            wrapper: :with_block_label

%hr.spacer/

- unless f.object.statuses.empty?
  %h4= t('filters.edit.statuses')

  %p.muted-hint= t('filters.edit.statuses_hint_html', path: filter_statuses_path(f.object, embedded_filter_options))

  %hr.spacer/

%h4= t('filters.edit.keywords')

.filter-keywords
  %details.filter-keywords__help
    %summary.filter-keywords__help-summary{ aria: { controls: 'filter-whole-word-help-body' } }= t('filters.edit.whole_word_help')
    #filter-whole-word-help-body.filter-keywords__help-body
      %p= t('simple_form.hints.defaults.whole_word')
  .filter-keywords__list
    = f.simple_fields_for :keywords do |keyword|
      = render 'keyword_fields', f: keyword
  = link_to_add_association f, :keywords, class: 'filter-keywords__add', partial: 'keyword_fields', 'data-association-insertion-node': '.filter-keywords__list', 'data-association-insertion-method': 'append' do
    = safe_join([fa_icon('plus'), t('filters.edit.add_keyword')])
